name: "{{@package 'displayName'}}"
desc: |-
  {{#each (split (@package 'description') "\n")}}
  {{{this}}}
  {{/each}}
openUrl: "{{@package 'openUrl'}}"
author: |-
  {{#each (@package 'contributors')}}
  {{this}}
  {{/each}}
homepage: "{{@package 'homepage'}}"
icon: "{{@package 'icon'}}"
category: "{{@package 'organizationName'}}"
date: "{{now "yyyy-MM-dd HH:mm:ss"}}"
version: "{{@package 'version'}}"

rules:
  # 📍 Country Code
  - DOMAIN,gspe1-ssl.ls.apple.com,DIRECT
  # 📍 Amap Dispatcher
  - DOMAIN,dispatcher.is.autonavi.com,DIRECT

http:
  mitm:
    - "gspe1-ssl.ls.apple.com"
    - "dispatcher.is.autonavi.com"
    - "configuration.ls.apple.com"
  script:
    - match: ^https?:\/\/gspe1-ssl\.ls\.apple\.com\/pep\/gcc
      name: LocationService.response
      type: response
      require-body: true
      argument:
    - match: ^https?:\/\/dispatcher\.is\.autonavi\.com\/dispatcher
      name: LocationService.request
      type: request
      require-body: true
      binary-mode: true
      argument:
    - match: ^https?:\/\/dispatcher\.is\.autonavi\.com\/dispatcher
      name: LocationService.response
      type: response
      require-body: true
      binary-mode: true
      argument:
    - match: ^https?:\/\/configuration\.ls\.apple\.com\/config\/defaults
      name: LocationService.request
      type: request
      argument:
    - match: ^https?:\/\/configuration\.ls\.apple\.com\/config\/defaults
      name: LocationService.response
      type: response
      require-body: true
      argument:

script-providers:
  LocationService.request:
    url: https://github.com/NSRingo/LocationService/releases/download/v{{@package 'version'}}/request.bundle.js
    interval: 86400
  LocationService.response:
    url: https://github.com/NSRingo/LocationService/releases/download/v{{@package 'version'}}/response.bundle.js
    interval: 86400
